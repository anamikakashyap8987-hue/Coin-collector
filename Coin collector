import pygame
import random
import sys
import os

pygame.init()

WIDTH, HEIGHT = 400, 600
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Coin Collector Pro")

clock = pygame.time.Clock()

# Images
player_img = pygame.image.load("player.png")
player_img = pygame.transform.scale(player_img, (50, 50))

coin_img = pygame.image.load("coin.png")
coin_img = pygame.transform.scale(coin_img, (30, 30))

font = pygame.font.SysFont("Arial", 28)
big_font = pygame.font.SysFont("Arial", 40)

def load_highscore():
    if os.path.exists("highscore.txt"):
        with open("highscore.txt", "r") as f:
            return int(f.read())
    return 0

def save_highscore(score):
    with open("highscore.txt", "w") as f:
        f.write(str(score))

def reset_game():
    player = player_img.get_rect()
    player.center = (WIDTH // 2, HEIGHT - 80)

    coin = coin_img.get_rect()
    coin.x = random.randint(20, WIDTH - 50)
    coin.y = random.randint(20, HEIGHT - 200)

    return player, coin

highscore = load_highscore()

player, coin = reset_game()

score = 0
game_time = 60
start_ticks = pygame.time.get_ticks()

game_over = False
running = True

while running:
    clock.tick(60)

    seconds = (pygame.time.get_ticks() - start_ticks) // 1000
    time_left = max(0, game_time - seconds)

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

        if not game_over:
            if event.type == pygame.MOUSEMOTION:
                player.center = event.pos

            if event.type == pygame.MOUSEBUTTONDOWN:
                player.center = event.pos

        else:
            if event.type == pygame.MOUSEBUTTONDOWN:
                score = 0
                start_ticks = pygame.time.get_ticks()
                player, coin = reset_game()
                game_over = False

    if not game_over:

        player.x = max(0, min(WIDTH - player.width, player.x))
        player.y = max(0, min(HEIGHT - player.height, player.y))

        if player.colliderect(coin):
            score += 1
            coin.x = random.randint(20, WIDTH - 50)
            coin.y = random.randint(20, HEIGHT - 200)

        if time_left <= 0:
            game_over = True

            if score > highscore:
                highscore = score
                save_highscore(highscore)

    screen.fill((20, 20, 30))

    if not game_over:

        screen.blit(player_img, player)
        screen.blit(coin_img, coin)

        screen.blit(
            font.render(f"Score: {score}", True, (255,255,255)),
            (10,10)
        )

        screen.blit(
            font.render(f"Time: {time_left}", True, (255,255,255)),
            (280,10)
        )

    else:

        game_over_text = big_font.render("GAME OVER", True, (255,0,0))
        score_text = font.render(f"Score: {score}", True, (255,255,255))
        high_text = font.render(f"High Score: {highscore}", True, (255,255,0))
        restart_text = font.render("Tap to Restart", True, (0,255,0))

        screen.blit(game_over_text, (80, 220))
        screen.blit(score_text, (130, 290))
        screen.blit(high_text, (105, 330))
        screen.blit(restart_text, (100, 390))

    pygame.display.flip()

pygame.quit()
sys.exit()
